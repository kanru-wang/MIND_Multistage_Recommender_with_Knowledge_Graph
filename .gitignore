# Ignore all files under any data folder
**/data/**

# Keep package source files under src/mindrec/data
!src/mindrec/data/
!src/mindrec/data/**

# Keep data files under scripts/data
!scripts/data/
!scripts/data/**

# Ignore local virtual environments
.venv/
venv/

# Ignore Python cache/bytecode files
__pycache__/
.pytest_tmp/
*.egg-info/
*.pyc
*.pyo
*.index
*.npy
*.pt

# Ignore tests
tests/

# Ignore certain runs
runs/mind_large_category_hour_analysis*/
runs/mind_large_tune*/
runs/mind_large_temporal_hard_neg*/
runs/mind_large_temporal_text_adapt*/
runs/mind_large_submission_text_adapt*/
runs/mind_large_submission*/submission/
runs/mind_small_temporal_tune_ranker_lr_*/
runs/mind_large_submission_item_age_residual_*/
runs/mind_large_submission_item_trend_*/
runs/mind_large_submission_hard_neg_*/
runs/mind_large_submission_content_trend_*/
runs/mind_large_semantic_burst_*/
runs/mind_large_content_trend_*/
runs/mind_large_recency_tiebreaker_tune_*/

# Ignore presentation files
docs/presentation/*
scripts/build_mind_presentation.py
scripts/render_pptx.ps1
